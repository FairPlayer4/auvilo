<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Alarms: the user grants "Wecker und Erinnerungen" and can take it back (Anf. 7.28 PS10;
         USE_EXACT_ALARM would need Google Play's review, docs/playstore.md P1) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground service that plays vibration/sound until the user reacts -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- Photo proof, taken inside the app and kept in app storage -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Arrival at home: geofence and a position check at the planned time, both in the background -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- WLAN as a place signal (Anf. 7.29): connection and Android's own scan results, no scanning -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Cloud-Backup, nur nach Einschalten (Anf. 7.28 PS8, 8.4; docs/cloud-entscheidungen.md A-3) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Destructive steps of the cloud backup ask for the screen lock (backend SE5). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Android 11+ only shows the speech recognition services to apps that ask (Anf. 7.35) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AvlApp"
        android:label="AuViLo-Reminder"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity="" />

        <!-- Quick reminder by voice from the widget (Anf. 7.35) -->
        <activity
            android:name=".voice.VoiceActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />

        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <!-- The running session with timer (Anf. 7.11); sessions last too long for shortService -->
        <service
            android:name=".alarm.SessionService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.ActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.OverviewReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.PreNoticeReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.PauseReceiver"
            android:exported="false" />

        <receiver
            android:name=".location.GeofenceReceiver"
            android:exported="false" />

        <receiver
            android:name=".location.WifiReceiver"
            android:exported="false" />

        <receiver
            android:name=".location.PlaceCheckReceiver"
            android:exported="false" />

        <receiver
            android:name=".system.SystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.AvlWidgetReceiver"
            android:exported="true"
            android:label="AuViLo-Reminder">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/avl_widget" />
        </receiver>

        <receiver
            android:name=".widget.VoiceWidgetReceiver"
            android:exported="true"
            android:label="Sprach-Reminder">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/voice_widget" />
        </receiver>
    </application>
</manifest>
